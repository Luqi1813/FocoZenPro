{
  "name": "focozen-pro",
  "version": "2.0.2",
  "description": "Estúdio de Foco Imersivo",
  "main": "main.js",
  "scripts": {
    "start": "npm run react:build && electron .",
    "react:build": "vite build",
    "react:watch": "vite build --watch",
    "dist": "npm run react:build && electron-builder",
    "test": "vitest run",
    "test:unit": "vitest run --dir tests/contracts tests/react",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.luqi.focozenpro",
    "productName": "FocoZen Pro",
    "files": [
      "**/*",
      "!dist/**/*",
      "dist/react/**/*",
      "assets/**/*",
      "vendor/**/*",
      "CHANGELOG.md",
      "!.kilo/**/*",
      "!tests/**/*",
      "!docs/**/*",
      "!README.md",
      "!vite.config.mjs",
      "!vitest.config.mjs"
    ],
    "publish": {
      "provider": "github",
      "owner": "Luqi1813",
      "repo": "FocoZenPro"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "FocoZen Pro",
      "perMachine": false,
      "allowElevation": false,
      "differentialPackage": true
    }
  },
  "author": "FocoZen",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^26.1.0",
    "vite": "^8.0.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
